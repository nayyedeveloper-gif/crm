{
  "name": "sale-dashboard-api",
  "version": "1.0.0",
  "description": "Backend API for 29 Jewellery Sale Dashboard — Google Sheets data + CRM database",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "export:sheets": "tsx scripts/export-sheets.ts",
    "export:sheets:sql": "tsx scripts/export-sheets.ts --sql",
    "sync:sheets": "tsx scripts/sync-to-db.ts",
    "sync:sheets:reset": "tsx scripts/sync-to-db.ts --reset",
    "check:sheets": "tsx scripts/check-sheets.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "papaparse": "^5.5.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
